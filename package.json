{
	"name": "myapp",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "gts lint && prettier --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"css": "npx tailwindcss -i ./src/input.css -o ./src/lib/css/output.css --watch",
		"serve-json": "json-server --watch db.json --port 5000",
		"clean": "gts clean",
		"compile": "tsc",
		"fix": "gts fix",
		"prepare": "npm.cmd run compile",
		"pretest": "npm.cmd run compile",
		"posttest": "npm.cmd run lint",
		"pocketbase": "/pocketbase serve",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@playwright/test": "^1.49.1",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.20.4",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.4",
		"@types/eslint": "^9.6.1",
		"@types/node": "22.13.17",
		"@typescript-eslint/eslint-plugin": "^8.29.1",
		"@typescript-eslint/parser": "^8.29.1",
		"autoprefixer": "^10.4.21",
		"drizzle-kit": "^0.30.2",
		"eslint": "^9.18.0",
		"eslint-config-airbnb-base": "^15.0.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-html": "^8.1.2",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-lit": "^1.15.0",
		"eslint-plugin-node": "^11.1.0",
		"eslint-plugin-prettier": "^5.2.6",
		"eslint-plugin-svelte": "^3.0.0",
		"eslint-plugin-svelte3": "^4.0.0",
		"eslint-plugin-wc": "^2.2.1",
		"globals": "^16.0.0",
		"gts": "^6.0.2",
		"jsdom": "^26.0.0",
		"mdsvex": "^0.12.3",
		"postcss": "^8.5.3",
		"postcss-import": "^16.1.0",
		"postcss-nesting": "^13.0.1",
		"postcss-preset-env": "^10.1.5",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.25.8",
		"svelte-check": "^4.1.5",
		"svelte-preprocess": "^6.0.3",
		"tailwind-scrollbar": "^3.1.0",
		"tailwind-vector-effect": "^1.0.2",
		"tailwindcss": "^4.0.0",
		"tailwindcss-border-image": "^1.1.2",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.2.5",
		"vitest": "^3.0.0"
	},
	"type": "module",
	"dependencies": {
		"@inlang/paraglide-js": "^2.0.0",
		"@libsql/client": "^0.14.0",
		"@node-rs/argon2": "^2.0.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/adapter-vercel": "^5.7.0",
		"drizzle-orm": "^0.40.0",
		"flowbite": "^2.5.2",
		"sanitize.css": "^13.0.0"
	}
}
